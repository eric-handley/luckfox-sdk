/dts-v1/;
#include "rv1106.dtsi"
#include "rv1106-luckfox-pico-zero-ipc.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/display/media-bus-format.h>
#include <dt-bindings/gpio/gpio.h>

/ {
    model = "UVR SRAD Camera";
    compatible = "rockchip,rv1106g-uvr-srad-camera", "rockchip,rv1106";

    chosen {
        bootargs = "earlycon=uart8250,mmio32,0xff4c0000 console=ttyS2,115200 root=/dev/mmcblk0p7 rootwait snd_soc_core.prealloc_buffer_size_kbytes=16";
    };

    restart-poweroff {
        compatible = "restart-poweroff";
    };

    cam_en: cam-enable {
        compatible = "regulator-fixed";
        regulator-name = "cam_en";
        regulator-always-on;
        regulator-boot-on;
        gpio = <&gpio2 RK_PA4 GPIO_ACTIVE_HIGH>;
        enable-active-high;
        pinctrl-names = "default";
        pinctrl-0 = <&cam_pwr_en>;
    };

    out_osc_imx519: out-osc-imx519 {
        compatible = "fixed-clock";
        clock-output-names = "out-osc-imx519";
        clock-frequency = <24000000>;
        #clock-cells = <0>;
    };
};

/**********CRU**********/
&cru {
    assigned-clocks =
        <&cru PLL_GPLL>, <&cru PLL_CPLL>,
        <&cru ARMCLK>,
        <&cru ACLK_PERI_ROOT>, <&cru HCLK_PERI_ROOT>,
        <&cru PCLK_PERI_ROOT>, <&cru ACLK_BUS_ROOT>,
        <&cru PCLK_TOP_ROOT>, <&cru PCLK_PMU_ROOT>,
        <&cru HCLK_PMU_ROOT>, <&cru CLK_500M_SRC>;
    assigned-clock-rates =
        <1188000000>, <700000000>,
        <1104000000>,
        <400000000>, <200000000>,
        <100000000>, <300000000>,
        <100000000>, <100000000>,
        <200000000>, <700000000>;
};

/**********NPU**********/
&npu {
    assigned-clock-rates = <700000000>;
};

/**********EMMC**********/
&emmc {
    status = "disabled";
};

&fiq_debugger {
    status = "disabled";
};

&uart2 {
    status = "okay";
};

/**********SD_CARD**********/
&sdmmc {
    max-frequency = <50000000>;
    bus-width = <4>;
    cap-sd-highspeed;
    cap-mmc-highspeed;
    disable-wp;
    no-sdio;
    no-mmc;
    supports-sd;
    rockchip,default-sample-phase = <90>;
    pinctrl-names = "default";
    pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_bus4>;
    status = "okay";
};

/**********SDIO**********/
&sdio {
    status = "disabled";
};

/**********ETH**********/
&gmac {
    status = "disabled";
};

/**********USB**********/
&usbdrd_dwc3 {
    status = "okay";
    dr_mode = "peripheral";
    //dr_mode = "host";
};

/**********RTC**********/
&rtc {
    status = "okay";
};

/**********CSI receiver (step 2a: D-PHY + MIPI + CIF; ISP still disabled)**********/
// &cam_ircut0 {
//     status = "disabled";
// };

&csi2_dphy_hw {
    status = "okay";
};

&csi2_dphy0 {
    status = "okay";
};

/* Repurpose the inherited imx415 dphy input (port@0/endpoint@1) for the
 * imx519 on i2c3, at 2 lanes. The inherited i2c4 sensors stay disabled. */
&csi_dphy_input1 {
    remote-endpoint = <&imx519_out>;
    data-lanes = <1 2>;
};

&i2c3 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&i2c3m0_xfer>;

    imx519: imx519@1a {
        compatible = "sony,imx519";
        status = "okay";
        reg = <0x1a>;
        clocks = <&out_osc_imx519>;
        clock-names = "xvclk";
        rockchip,camera-module-index = <0>;
        rockchip,camera-module-facing = "back";
        rockchip,camera-module-name = "arducam-imx519";
        rockchip,camera-module-lens-name = "default";
        lens-focus = <&ak7375>;
        port {
            imx519_out: endpoint {
                remote-endpoint = <&csi_dphy_input1>;
                data-lanes = <1 2>;
                link-frequencies = /bits/ 64 <493500000>;
            };
        };
    };

    /* AK7375 VCM (autofocus). Driver ported onto the Rockchip rk_cam_vcm
     * framework so rkaiq can drive continuous AF. The vcm-*-current props
     * map the logical-position range across the 12-bit DAC; the AK7375 has
     * no real current rating, so these are DAC proxies (start 0 -> rated
     * full-scale). module-index/facing are required by the driver's DT
     * parse and must match the sensor. */
    ak7375: ak7375@c {
        compatible = "asahi-kasei,ak7375";
        status = "okay";
        reg = <0x0c>;
        rockchip,camera-module-index = <0>;
        rockchip,camera-module-facing = "back";
        rockchip,vcm-max-current = <100>;
        rockchip,vcm-start-current = <0>;
        rockchip,vcm-rated-current = <100>;
        rockchip,vcm-step-mode = <0>;
    };
};

&i2c4 {
    status = "disabled";
};

&mipi0_csi2 {
    status = "okay";
};

&rkcif {
    status = "okay";
};

&rkcif_mipi_lvds {
    status = "okay";
};

/* sditf is the direct-to-ISP path (step 3: CIF -> ISP). Endpoint wiring
 * (mipi_lvds_sditf <-> isp_in) is inherited from the base dtsi. */
&rkcif_mipi_lvds_sditf {
    status = "okay";
};

&rkisp {
    status = "okay";
};

&rkisp_vir0 {
    status = "okay";
};

/**********SPI**********/
&spi0 {
    status = "disabled";
    spidev@0 {
        spi-max-frequency = <50000000>;
    };
};

/**********PINCTRL**********/
&pinctrl {
    camera {
        cam_pwr_en: cam-pwr-en {
            rockchip,pins = <2 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
        };
    };
};
