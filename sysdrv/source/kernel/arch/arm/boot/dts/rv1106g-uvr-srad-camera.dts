/dts-v1/;
#include "rv1106.dtsi"
#include "rv1106-luckfox-pico-zero-ipc.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/display/media-bus-format.h>

/ {
    model = "UVR SRAD Camera";
    compatible = "rockchip,rv1106g-uvr-srad-camera", "rockchip,rv1106";

    chosen {
        bootargs = "earlycon=uart8250,mmio32,0xff4c0000 console=ttyS2,115200 root=/dev/mmcblk0p7 rootwait snd_soc_core.prealloc_buffer_size_kbytes=16 coherent_pool=0";
    };

    restart-poweroff {
        compatible = "restart-poweroff";
    };
};

/**********CRU**********/
&cru {
    assigned-clocks =
        <&cru PLL_GPLL>, <&cru PLL_CPLL>,
        <&cru ARMCLK>,
        <&cru ACLK_PERI_ROOT>, <&cru HCLK_PERI_ROOT>,
        <&cru PCLK_PERI_ROOT>, <&cru ACLK_BUS_ROOT>,
        <&cru PCLK_TOP_ROOT>, <&cru PCLK_PMU_ROOT>,
        <&cru HCLK_PMU_ROOT>, <&cru CLK_500M_SRC>;
    assigned-clock-rates =
        <1188000000>, <700000000>,
        <1104000000>,
        <400000000>, <200000000>,
        <100000000>, <300000000>,
        <100000000>, <100000000>,
        <200000000>, <700000000>;
};

/**********NPU**********/
&npu {
    assigned-clock-rates = <700000000>;
};

/**********EMMC**********/
&emmc {
    status = "disabled";
};

&fiq_debugger {
    status = "disabled";
};

&uart2 {
    status = "okay";
};

/**********SD_CARD**********/
&sdmmc {
    max-frequency = <50000000>;
    bus-width = <4>;
    cap-sd-highspeed;
    cap-mmc-highspeed;
    disable-wp;
    no-sdio;
    no-mmc;
    supports-sd;
    rockchip,default-sample-phase = <90>;
    pinctrl-names = "default";
    pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_bus4>;
    status = "okay";
};

/**********SDIO**********/
&sdio {
    status = "disabled";
};

/**********ETH**********/
&gmac {
    status = "disabled";
};

/**********USB**********/
&usbdrd_dwc3 {
    status = "okay";
    dr_mode = "peripheral";
    //dr_mode = "host";
};

/**********RTC**********/
&rtc {
    status = "okay";
};

/**********SPI**********/
&spi0 {
    status = "disabled";
    spidev@0 {
        spi-max-frequency = <50000000>;
    };
};
