#!/bin/sh
#
# USB gadget setup — RNDIS only
#

CONFIGFS_DIR=/sys/kernel/config
USB_CONFIGFS_DIR=${CONFIGFS_DIR}/usb_gadget/rockchip
USB_STRINGS_DIR=${USB_CONFIGFS_DIR}/strings/0x409
USB_FUNCTIONS_DIR=${USB_CONFIGFS_DIR}/functions
USB_CONFIGS_DIR=${USB_CONFIGFS_DIR}/configs/b.1

case "$1" in
start)
    ifconfig lo up

    mount -t configfs none ${CONFIGFS_DIR}
    mkdir -p ${USB_CONFIGFS_DIR}
    echo 0x2207 > ${USB_CONFIGFS_DIR}/idVendor
    echo 0x0019 > ${USB_CONFIGFS_DIR}/idProduct
    echo 0x0310 > ${USB_CONFIGFS_DIR}/bcdDevice
    echo 0x0200 > ${USB_CONFIGFS_DIR}/bcdUSB

    mkdir -p ${USB_STRINGS_DIR}
    SERIAL=$(grep Serial /proc/cpuinfo | awk '{print $3}')
    echo ${SERIAL:-0123456789ABCDEF} > ${USB_STRINGS_DIR}/serialnumber
    echo "rockchip" > ${USB_STRINGS_DIR}/manufacturer
    echo "UVR SRAD Camera" > ${USB_STRINGS_DIR}/product

    mkdir -p ${USB_FUNCTIONS_DIR}/rndis.gs0
    mkdir -p ${USB_CONFIGS_DIR}/strings/0x409
    echo 500 > ${USB_CONFIGS_DIR}/MaxPower
    ln -s ${USB_FUNCTIONS_DIR}/rndis.gs0 ${USB_CONFIGS_DIR}/f1
    echo rndis > ${USB_CONFIGS_DIR}/strings/0x409/configuration

    UDC=$(ls /sys/class/udc/ | head -1)
    echo ${UDC} > ${USB_CONFIGFS_DIR}/UDC

    # IP configured by S99usb0config
    ;;
stop)
    echo "none" > ${USB_CONFIGFS_DIR}/UDC
    rm -f ${USB_CONFIGS_DIR}/f1
    ;;
restart|reload)
    $0 stop
    sleep 1
    $0 start
    ;;
*)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
