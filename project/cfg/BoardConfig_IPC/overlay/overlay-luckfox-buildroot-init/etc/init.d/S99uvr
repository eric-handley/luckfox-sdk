#!/bin/sh
#
# uvr        Starts the UVR SoC supervisor (camera + IMU logging + heartbeat).
#

SUPERVISOR=/usr/bin/uvr_supervisor.py
PIDFILE=/var/run/uvr_supervisor.pid
LOG=/data/uvr-supervisor.log

[ -f "$SUPERVISOR" ] || exit 0

start() {
    printf "Starting uvr supervisor: "
    # Not a login shell, so pull in RkEnv.sh for LD_LIBRARY_PATH; without it
    # uvr-vicap can't load librockit.so from /oem/usr/lib.
    . /etc/profile >/dev/null 2>&1 || true
    python3 "$SUPERVISOR" >>"$LOG" 2>&1 &
    echo $! > "$PIDFILE"
    echo "OK"
}
stop() {
    printf "Stopping uvr supervisor: "
    [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    echo "OK"
}
restart() {
    stop
    sleep 1
    start
}

case "$1" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  restart|reload)
    restart
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
esac

exit $?
